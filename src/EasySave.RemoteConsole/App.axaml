<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:EasySave.RemoteConsole.Converters"
             x:Class="EasySave.RemoteConsole.App">

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <Application.Resources>
    <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter" />
  </Application.Resources>

</Application>
